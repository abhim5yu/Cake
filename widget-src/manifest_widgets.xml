    <!-- Cake home-screen widgets. Inserted into AndroidManifest.xml by the build workflow. -->
    <receiver
        android:name="com.abhim5yu.cake.widgets.SmallWidgetProvider"
        android:exported="true"
        android:label="@string/widget_small_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_small_info" />
    </receiver>

    <receiver
        android:name="com.abhim5yu.cake.widgets.MediumWidgetProvider"
        android:exported="true"
        android:label="@string/widget_medium_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_medium_info" />
    </receiver>

    <receiver
        android:name="com.abhim5yu.cake.widgets.LargeWidgetProvider"
        android:exported="true"
        android:label="@string/widget_large_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_large_info" />
    </receiver>

    <activity
        android:name="com.abhim5yu.cake.widgets.WidgetConfigActivity"
        android:exported="true"
        android:label="@string/widget_large_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent-filter>
    </activity>
